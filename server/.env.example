# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# If left empty, a local MongoDB or lightweight in-memory MongoDB instance is automatically used
MONGODB_URI=mongodb://localhost:27017/college_complaint_db

# Security & Auth
JWT_SECRET=super_secret_college_complaint_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173

# Optional Email Configuration (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="College Helpdesk" <no-reply@college.edu>

# Optional AI Services (Google Gemini / OpenRouter)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
